GROUP_IDS=12036301@g.us,12036302@g.us
AFFILIATE_TAG_SHOPEE=
AFFILIATE_TAG_ML=
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_AUTO_SEARCH=true
# discount-only: API-reported discounts. regular: all offers. flash-only: blocked.
SHOPEE_OFFER_MODE=discount-only
# Audio, phones, computers, gaming and cameras; empty allows all categories.
SHOPEE_CATEGORY_IDS=
SHOPEE_MIN_SALES=0
OFFER_HEADLINE="RADAR SHOPEE: TECNOLOGIA NA ÁREA ⚡"
CRON_INTERVAL="* * * * *"
TIMEZONE=America/Sao_Paulo
DEDUP_HOURS=24
DELAY_MIN_MS=5000
DELAY_MAX_MS=15000
DEALS_FILE=./deals.json
# Optional authenticated converter you own: POST {url,tag} -> {affiliateUrl}
ML_CONVERTER_URL=
ML_CONVERTER_TOKEN=
FAILED_OFFER_COOLDOWN_MINUTES=30
SEND_TIMEOUT_SECONDS=45
SEND_INTERVAL_MIN_MINUTES=10
SEND_INTERVAL_MAX_MINUTES=15
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3210

# Instagram: preview only by default. Do not enable live mode without explicit initial approval.
# Credentials stay on the server; never put tokens in dashboard JavaScript.
INSTAGRAM_TEST_MODE=true
INSTAGRAM_LIVE_APPROVED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Set a version supported by your Meta app (for example v25.0); verify before live setup.
INSTAGRAM_API_VERSION=
# facebook (Facebook Login) or instagram (Instagram Login)
INSTAGRAM_LOGIN_TYPE=facebook
# BUSINESS or CREATOR. Official Stories publishing requires BUSINESS.
INSTAGRAM_ACCOUNT_TYPE=BUSINESS
# Public HTTPS origin mapped to this dashboard's /instagram-media/ route.
# Leave blank for local previews; do not expose the dashboard during initial setup.
INSTAGRAM_PUBLIC_BASE_URL=
