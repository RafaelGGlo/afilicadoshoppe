# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# Credenciais da API de afiliados (painel: https://affiliate.shopee.com.br/open_api)
# Deixe vazio para usar o MODO DEMONSTRAÇÃO (dados simulados, claramente identificados)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Endereço da API (Brasil). Só mude se a documentação oficial mudar.
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Servidor
PORT=3000
HOST=127.0.0.1

# Senha do painel (OBRIGATÓRIA se HOST=0.0.0.0 ou se for abrir pela internet)
PANEL_PASSWORD=troque-esta-senha
# Texto aleatório longo para assinar o cookie de login
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-longo

# Pasta do banco SQLite e das imagens
DATA_DIR=./data
